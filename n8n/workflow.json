        "query": "=BEGIN;\n  UPDATE leads \n  SET pipeline_stage = 'contacted', updated_at = now() \n  WHERE id = '{{ $json.id }}';\n\n  INSERT INTO pipeline_logs (lead_id, event_type, payload) \n  VALUES (\n    '{{ $json.id }}', \n    'stage_updated', \n    '{\"from\": \"new\", \"to\": \"contacted\", \"trigger\": \"n8n_flow\"}'::jsonb\n  );\nCOMMIT;"
      },
